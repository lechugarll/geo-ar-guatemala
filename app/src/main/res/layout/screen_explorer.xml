<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla Explorer: overlay AR sobre la cámara + barra de estado inferior -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Overlay AR (etiquetas de accidentes geográficos + reticle central) -->
    <com.geoar.guatemala.CameraOverlayView
        android:id="@+id/ar_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================================================================== -->
    <!-- Tarjeta de identificación automática (Google Lens style)            -->
    <!-- Aparece tras 2 s apuntando al mismo accidente geográfico            -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/card_auto_detectado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="210dp"
        android:background="@drawable/shape_panel_resultado"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <!-- Nombre del lugar identificado -->
        <TextView
            android:id="@+id/auto_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="2dp" />

        <!-- Tipo · Distancia · Elevación -->
        <TextView
            android:id="@+id/auto_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_auto_cerrar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cerrar"
                android:textColor="@color/on_surface_variant" />

            <Button
                android:id="@+id/btn_auto_maps"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_ver_en_maps"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/btn_auto_detalles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/btn_detalles"
                android:textColor="@color/on_primary"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="@color/primary"
                app:cornerRadius="24dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================================================================== -->
    <!-- Tarjeta flotante de estado GPS/Brújula (inferior)                   -->
    <!-- ================================================================== -->
    <LinearLayout
        android:id="@+id/barra_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="116dp"
        android:background="@drawable/shape_chip"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Coordenadas grandes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/coord_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="--.-°N" />

            <TextView
                android:id="@+id/coord_lon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:gravity="end"
                android:text="--.-°W" />

        </LinearLayout>

        <!-- GPS precision + Brújula estado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/estado_gps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:text="● GPS · Buscando…" />

            <TextView
                android:id="@+id/estado_brujula"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                android:letterSpacing="0.02"
                android:gravity="end"
                android:text="Brújula · —" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
