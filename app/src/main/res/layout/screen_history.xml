<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla History/Archive: listado de escaneos previos -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Encabezado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expedition_log"
            android:textColor="@color/on_surface"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/label_total_sites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:letterSpacing="0.01"
            android:text="0 lugares registrados" />

    </LinearLayout>

    <!-- Filter chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/chip_reciente"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/filter_recent"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"
            app:strokeColor="@color/primary"
            android:textColor="@color/primary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <Button
            android:id="@+id/chip_volcanes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/filter_volcanoes"
            android:textSize="11sp"
            android:layout_marginEnd="8dp"
            app:strokeColor="@color/outline_variant"
            android:textColor="@color/on_surface_variant"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <Button
            android:id="@+id/chip_lagos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/filter_lakes"
            android:textSize="11sp"
            app:strokeColor="@color/outline_variant"
            android:textColor="@color/on_surface_variant"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <!-- Lista de escaneos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_historial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="108dp" />

    <!-- Mensaje vacío -->
    <TextView
        android:id="@+id/label_historial_vacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.6"
        android:text="@string/history_empty"
        android:visibility="gone" />

    <!-- Card de Regional Coverage -->
    <LinearLayout
        android:id="@+id/card_coverage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="108dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regional_coverage"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/label_coverage_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <ProgressBar
            android:id="@+id/progress_coverage"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/surface_container_high" />

    </LinearLayout>

</LinearLayout>
