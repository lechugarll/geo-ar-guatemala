<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ===== CÁMARA (siempre detrás, visible en Explorer y Scan) ===== -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <!-- ===== PANTALLA DE PERMISOS ===== -->
    <LinearLayout
        android:id="@+id/pantalla_permisos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️"
            android:textSize="72sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_permisos"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descripcion_permisos"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_reintentar_permisos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_otorgar_permisos"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:textColor="@color/on_primary"
            app:backgroundTint="@color/primary" />

    </LinearLayout>

    <!-- ===== EXPLORER SCREEN (overlay AR sobre cámara) ===== -->
    <include
        android:id="@+id/screen_explorer"
        layout="@layout/screen_explorer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== SCAN SCREEN (visor + animación + resultado) ===== -->
    <include
        android:id="@+id/screen_scan"
        layout="@layout/screen_scan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== HISTORY SCREEN (fondo sólido, lista de escaneos) ===== -->
    <include
        android:id="@+id/screen_history"
        layout="@layout/screen_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ===== TOP BAR (siempre visible cuando hay permisos) ===== -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC121416"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_display_name"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/label_tab_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <!-- Avatar placeholder -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="JL"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/shape_scan_btn" />

    </LinearLayout>

    <!-- ===== BOTTOM NAV (siempre visible cuando hay permisos) ===== -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="#EE0C0E10"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- Tab: Explorer -->
        <LinearLayout
            android:id="@+id/tab_explorer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_explorer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_explorer"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_explorer"
                android:textColor="@color/primary"
                android:textSize="9sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- Tab: Scan (centro elevado) -->
        <FrameLayout
            android:id="@+id/tab_scan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:background="@drawable/shape_scan_btn"
                android:elevation="6dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_scan" />

            </LinearLayout>

        </FrameLayout>

        <!-- Tab: Archive -->
        <LinearLayout
            android:id="@+id/tab_archive"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/icon_archive"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_archive"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_archive"
                android:textColor="@color/on_surface_variant"
                android:textSize="9sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
