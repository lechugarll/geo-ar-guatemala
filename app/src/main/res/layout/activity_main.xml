<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Pantalla de permisos -->
    <LinearLayout
        android:id="@+id/pantalla_permisos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️"
            android:textSize="72sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_permisos"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descripcion_permisos"
            android:textColor="#BDBDBD"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_reintentar_permisos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_otorgar_permisos"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            app:backgroundTint="@color/color_volcan_activo" />

    </LinearLayout>

    <!-- Contenido principal -->
    <FrameLayout
        android:id="@+id/contenido_principal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Preview de cámara fullscreen -->
        <androidx.camera.view.PreviewView
            android:id="@+id/camera_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="performance"
            app:scaleType="fillCenter" />

        <!-- Overlay AR -->
        <com.geoar.guatemala.CameraOverlayView
            android:id="@+id/ar_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Botón info (esquina superior derecha) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/btn_info_descripcion"
            android:src="@android:drawable/ic_menu_info_details"
            app:backgroundTint="@color/color_boton_info"
            app:tint="@android:color/white"
            app:fabSize="mini" />

        <!-- Botón escanear estilo Google Lens (centro inferior) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_escanear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:contentDescription="@string/btn_escanear_descripcion"
            android:src="@android:drawable/ic_menu_camera"
            app:backgroundTint="@color/color_boton_escanear"
            app:tint="@android:color/white"
            app:fabSize="normal" />

        <!-- Panel de resultado del escaneo (se muestra al pulsar Escanear) -->
        <LinearLayout
            android:id="@+id/panel_resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E6000000"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <!-- Nombre del accidente -->
            <TextView
                android:id="@+id/resultado_nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Tipo · distancia · elevación -->
            <TextView
                android:id="@+id/resultado_tipo_distancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#90CAF9"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <!-- Descripción -->
            <TextView
                android:id="@+id/resultado_descripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E0E0E0"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="20dp" />

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btn_cerrar_resultado"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_cerrar"
                    android:textColor="#BDBDBD" />

                <Button
                    android:id="@+id/btn_ver_en_maps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_ver_en_maps"
                    app:backgroundTint="@color/color_boton_maps" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
