<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de escaneo estilo shutter de Apple: anillo blanco + espacio + círculo de acento -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Anillo exterior -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="2.5dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>

    <!-- Círculo interior con acento (gap visible entre anillo y relleno) -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/primary" />
        </shape>
    </item>

</layer-list>
