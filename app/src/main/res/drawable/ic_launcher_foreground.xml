<?xml version="1.0" encoding="utf-8"?>
<!--
    Ícono GeoAR Guatemala.
    Viewport 108×108.

    Elementos:
      • Volcán   — triángulo simétrico con cráter en V (izquierda-centro)
      • Fumarola — tres nubes circulares superpuestas sobre el cráter
      • Cámara   — cuerpo redondeado + objetivo circular (derecha)

    Todos los elementos son blancos sobre el fondo verde (#1E8A5E).
    El objetivo de la cámara usa fillType evenOdd para perforar un hueco
    que deja ver el fondo verde, simulando el cristal del lente.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        ══ VOLCÁN ══
        Cono con cráter en V bien marcado.
        Puntos clave:
          Base:         (10, 84) → (62, 84)   — base ancha
          Ladera izq:   (10, 84) → (28, 26)
          Cráter izq:   (28, 26) → (34, 38)   — bajada al interior del cráter
          Cráter der:   (34, 38) → (40, 26)   — subida al otro borde del cráter
          Ladera der:   (40, 26) → (62, 84)
        El cráter tiene 12 px de profundidad — claramente visible en todos los tamaños.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M10,84
            L28,26
            L34,38
            L40,26
            L62,84
            Z" />

    <!--
        ══ FUMAROLA ══
        Tres círculos sólidos superpuestos que forman una nube de humo
        ascendiendo desde el cráter (centrado en x≈35, sobre y=26).
        Los tamaños crecen hacia arriba para dar sensación de expansión.
    -->
    <!-- Puff inferior: surge justo del cráter -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,20 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <!-- Puff superior izquierdo -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M22,10 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <!-- Puff superior derecho -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,8 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />

    <!--
        ══ CÁMARA ══
        Cuerpo rectangular redondeado (esquinas r=4) con objetivo en el centro.
        Se usa fillType="evenOdd" para crear un hueco circular (el lente):
        la subpath del círculo resta al rectángulo, dejando ver el verde del fondo.
        Posición: x=64-96, y=38-70 (cuerpo), bump superior y=30-38.
    -->
    <!-- Visor / bump superior de la cámara -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M70,38 L70,30 L90,30 L90,38 Z" />

    <!-- Cuerpo + hueco del objetivo (evenOdd) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M64,42 Q64,38 68,38 L92,38 Q96,38 96,42
            L96,66 Q96,70 92,70 L68,70 Q64,70 64,66 Z
            M72,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />

    <!-- Destello / reflejo en el objetivo (punto blanco en el lente verde) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M78,50 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

</vector>
